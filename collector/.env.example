# Public application origin plus server-generated secrets. Never commit real values.
AUTOHUNTER_APP_URL=https://autohunter.example.com
AUTOHUNTER_INGEST_SECRET=replace-with-a-random-secret
AUTOHUNTER_CRON_SECRET=replace-with-a-different-random-secret

# Optional licensed inventory provider. Without it, MarketCheck reports unavailable and makes no request.
MARKETCHECK_API_KEY=

# Optional licensed Auto.dev inventory provider. Without it, Auto.dev reports unavailable.
AUTODEV_API_KEY=

# Optional local GOG adapter. Only messages carrying this dedicated Gmail label are read.
AUTOHUNTER_GMAIL_QUERY='label:"AutoHunter/Lease Inputs" newer_than:14d'

# Optional. Defaults to ./config.example.json.
AUTOHUNTER_CONFIG=./platform.example.json
