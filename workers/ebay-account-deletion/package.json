  "devDependencies": {
    "@cloudflare/vitest-plugin": "1.4.11",
    "@cloudflare/workers-types": "5.20261031.1",
    "@types/node": "26.6.6",
    "typescript": "7.0.2",
    "vitest": "4.1.12",
    "wrangler": "4.156.0"
  }
}
