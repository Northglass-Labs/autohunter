{
  "name": "@northglass/ebay-account-deletion-worker",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "check": "npm run types:check && npm run typecheck && npm test && npm run deploy:dry-run",
    "deploy:dry-run": "wrangler deploy --dry-run --outdir dist",
