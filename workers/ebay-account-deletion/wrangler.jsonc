{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "ebay-account-deletion",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-30",
  "workers_dev": true,
  "preview_urls": true,
  "secrets": {
    "required": [
      "EBAY_CLIENT_ID",
      "EBAY_CLIENT_SECRET",
      "EBAY_DELETION_VERIFICATION_TOKEN"
    ]
  },
  "observability": {
    "enabled": true,
    "redact_query_string": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true,
      "persist": true
    }
  }
}
