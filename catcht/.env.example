# Server-only database connection from a dedicated Supabase project (pooled connection preferred)
DATABASE_URL=
# Optional PEM bundle for providers with a private database CA (required by the Supabase pooler).
# Store the full multiline certificate in your deployment secret manager.
DATABASE_CA_CERT=
# Use `disable` only for a local database while running `next dev`; production rejects it.
DATABASE_SSL_MODE=verify-full

# At least 32 random bytes each. Never expose with NEXT_PUBLIC_.
ACTION_SIGNING_SECRET=
CRON_SECRET=
INGEST_SECRET=

# Supabase Auth identity only. The publishable key is intentionally browser-visible, while the
# private `catcht` schema remains inaccessible to browser roles.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

APP_URL=http://localhost:3000
APP_NAME=AutoHunter
# Optional copy used in generic metadata; real recipients live in `catcht.user_profiles`.
RECIPIENT_NAME=the household
EMAIL_FROM=AutoHunter <carhunt@northglass.io>
RESEND_API_KEY=

# Legacy single-search defaults retained only for preserved enthusiast records.
# New searches are stored and enforced independently in the dashboard.
SEARCH_ZIP=
SEARCH_LOCATION_LABEL=
SEARCH_RADIUS_MILES=150
SEARCH_MAX_PRICE=15000
SEARCH_MAX_MILEAGE=120000

# Vision verification. `disabled`, `openai`, or `vercel-gateway`.
# Vercel supplies OIDC on each Function request; do not copy that token into this file.
VISION_PROVIDER=disabled
OPENAI_API_KEY=
OPENAI_VISION_MODEL=gpt-5.4-mini
